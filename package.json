{
  "name": "sean-whalen-poetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "serve out -l 4173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:built": "pnpm check:export && pnpm check:links && pnpm check:seo",
    "blank:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/blank-starter.ps1 -Initialize",
    "blank:archive": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/blank-starter.ps1 -Archive",
    "blank:copy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/blank-starter.ps1 -Copy -Destination",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:tokens && pnpm test",
    "ci": "pnpm verify",
    "verify": "pnpm check && pnpm test:e2e && pnpm check:built"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
